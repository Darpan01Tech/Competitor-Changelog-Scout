# Copy this file to .env.local for local development. Replace placeholders locally; never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Dedicated, low-privilege shared hackathon reviewer account (server only).
# Supabase Auth validates the email/password submitted in the sign-in form.
# Match these to the Auth user. Never use an admin account. These values are
# never returned to the UI; copy this template and fill them in .env.local.
DEMO_REVIEWER_EMAIL=reviewer@example.invalid
DEMO_REVIEWER_PASSWORD=replace-with-a-local-only-password
DEMO_REVIEWER_USER_ID=00000000-0000-4000-8000-000000000000
SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_DASHBOARD_REFRESH_INTERVAL_MS=15000
LOVABLE_API_KEY=your-server-side-lovable-api-key
# Optional: only for Drizzle migrations.
LOVABLE_DB_MIGRATION_URL=postgresql://user:password@host:5432/database
# Optional only if a route begins using the generated cron-auth helper.
LOVABLE_CRON_SECRET=replace-with-a-random-server-secret
# Optional during secret rotation.
LOVABLE_CRON_SECRET_PREVIOUS=replace-with-the-previous-server-secret
